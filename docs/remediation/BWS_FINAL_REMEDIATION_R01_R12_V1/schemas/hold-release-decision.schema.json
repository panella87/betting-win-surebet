          "enum": [
            "BLOCKED",
            "RELEASED"
          ]
        },
        "BWS-710": {
          "enum": [
            "BLOCKED",
            "RELEASED"
          ]
        },
        "BWS-900": {
          "enum": [
            "PARKED_NOT_AUTHORIZED",
            "AUTHORIZED"
          ]
        },
        "deployment": {
          "enum": [
            "BLOCKED",
            "RELEASED"
          ]
        },
        "live_execution": {
          "enum": [
            "PROHIBITED",
            "AUTHORIZED"
          ]
        },
        "release": {
