            {
              "pattern": "^[0-7]{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "postimage_sha256": {
          "oneOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "preimage_mode": {
          "oneOf": [
            {
              "pattern": "^[0-7]{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "preimage_sha256": {
          "oneOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
